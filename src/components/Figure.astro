---
import { Image } from 'astro:assets';

interface Props {
    src: ImageMetadata;
    alt: string;
    class?: string;
}

const { src, alt, class: className } = Astro.props;
---

<figure>
    <Image src={src} alt={alt} layout="constrained" class:list={['block', className]} />
    <figcaption><slot /></figcaption>
</figure>
