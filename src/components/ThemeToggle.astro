---
import SystemThemeSolidIcon from '@/assets/icons/system-theme-20.svg';
import SystemThemeIcon from '@/assets/icons/system-theme-24.svg';
import MoonSolidIcon from 'heroicons/20/solid/moon.svg';
import SunSolidIcon from 'heroicons/20/solid/sun.svg';
import MoonIcon from 'heroicons/24/outline/moon.svg';
import SunIcon from 'heroicons/24/outline/sun.svg';
---

<div class="flex items-center">
    <div class="relative inline-block text-left">
        <div>
            <button
                type="button"
                class="rounded-full flex items-center text-slate-500 hover:text-brand dark:text-slate-300 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
                id="menu-button"
                aria-expanded="false"
                aria-haspopup="true"
                aria-controls="theme-menu"
            >
                <span class="sr-only">Open options</span>
                <SunIcon class="h-6 w-6 hidden in-data-[theme=light]:block" />
                <MoonIcon class="h-6 w-6 hidden in-data-[theme=dark]:block" />
                <SystemThemeIcon class="h-6 w-6 hidden in-data-[theme=system]:block" />
            </button>
        </div>

        <div
            id="theme-menu"
            inert
            class="transition ease-out duration-100 inert:opacity-0 inert:scale-95 origin-top-right absolute right-0 z-10 mt-2 w-32 rounded-xl shadow-lg bg-paper ring-1 ring-hill-front/10 dark:ring-white/10 focus:outline-hidden"
            role="menu"
            aria-orientation="vertical"
            aria-labelledby="menu-button"
            tabindex="-1"
        >
            <div class="p-1" role="none">
            <button
                class="w-full text-slate-700 dark:text-slate-200 aria-checked:text-brand aria-checked:font-semibold px-3 py-2 rounded-lg text-sm flex items-center cursor-pointer hover:bg-sky"
                role="menuitemradio"
                aria-checked="false"
                tabindex="-1"
                data-theme="light"
            >
                <SunSolidIcon class="h-5 w-5 mr-2" />
                Light
            </button>
            <button
                class="w-full text-slate-700 dark:text-slate-200 aria-checked:text-brand aria-checked:font-semibold px-3 py-2 rounded-lg text-sm flex items-center cursor-pointer hover:bg-sky"
                role="menuitemradio"
                aria-checked="false"
                tabindex="-1"
                data-theme="dark"
            >
                <MoonSolidIcon class="h-5 w-5 mr-2" />
                Dark
            </button>
            <button
                class="w-full text-slate-700 dark:text-slate-200 aria-checked:text-brand aria-checked:font-semibold px-3 py-2 rounded-lg text-sm flex items-center cursor-pointer hover:bg-sky"
                role="menuitemradio"
                aria-checked="false"
                tabindex="-1"
                data-theme="system"
            >
                <SystemThemeSolidIcon class="h-5 w-5 mr-2" />
                System
            </button>
            </div>
        </div>
    </div>
</div>

<script>
    declare function applyTheme(): void;

    const button = document.getElementById('menu-button')!;
    const menu = document.getElementById('theme-menu')!;
    const items = menu.querySelectorAll<HTMLElement>('[data-theme]');

    function setOpen(open: boolean) {
        if (open) {
            markCurrent();
        }

        menu.inert = !open;
        button.setAttribute('aria-expanded', String(open));
    }

    function markCurrent() {
        const current = localStorage.theme ?? 'system';

        items.forEach((item) => item.setAttribute('aria-checked', String(item.dataset.theme === current)));
    }

    button.addEventListener('click', () => setOpen(menu.inert));

    document.addEventListener('click', (event) => {
        if (!button.contains(event.target as Node)) {
            setOpen(false);
        }
    });

    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
            setOpen(false);
        }
    });

    items.forEach((item) => {
        item.addEventListener('click', () => {
            localStorage.theme = item.dataset.theme;
            applyTheme();
            markCurrent();
        });
    });

    const prefersDark = matchMedia('(prefers-color-scheme: dark)');

    prefersDark.addEventListener('change', applyTheme);

    document.querySelectorAll('[data-theme-switch]').forEach((sun) =>
        sun.addEventListener('click', () => {
            const toDark = !document.documentElement.classList.contains('dark');

            localStorage.theme = toDark === prefersDark.matches ? 'system' : toDark ? 'dark' : 'light';
            applyTheme();
            markCurrent();
        }),
    );

    markCurrent();
</script>
