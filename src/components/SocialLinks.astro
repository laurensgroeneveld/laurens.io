---
import { socials } from '@/socials';

interface Props {
    class?: string;
}

const { class: className } = Astro.props;
---

<p class:list={['flex flex-wrap items-center gap-x-4 gap-y-2', className]}>
    <span class="whitespace-nowrap">Find me here:</span>
    <span class="flex items-center gap-x-4">
        {socials.map(({ title, href, Icon }) => (
            <a href={href} target="_blank" rel="noopener noreferrer me" title={title}>
                <Icon class="size-6 fill-slate-700 transition-colors hover:fill-brand dark:fill-slate-300" />
            </a>
        ))}
    </span>
</p>
