---
import Base from '@/layouts/Base.astro';
import PostList from '@/components/PostList.astro';
import RssIcon from 'heroicons/20/solid/rss.svg';

const title = 'Blog';
---

<Base title={title}>
    <header class="mb-10">
        <div class="flex items-center justify-between">
            <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                {title}
            </h1>
            <a href="/feed.xml" class="text-slate-400 hover:text-brand dark:text-slate-500" title="RSS feed">
                <RssIcon class="size-5" />
            </a>
        </div>
    </header>

    <PostList />
</Base>
