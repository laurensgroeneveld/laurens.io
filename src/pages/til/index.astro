---
import { render } from 'astro:content';
import LinkIcon from 'heroicons/16/solid/link.svg';
import Page from '@/layouts/Page.astro';
import { getLearnings } from '@/utils/content';
import { formatDate } from '@/utils/date';

const learnings = await getLearnings();
const rendered = await Promise.all(
    learnings.map(async (learning) => ({ learning, Content: (await render(learning)).Content })),
);
---

<Page title="TIL" subtitle="💡 Quick notes on things I learned today" prose={false}>
    <div class="space-y-8">
        {rendered.map(({ learning, Content }) => (
            <div>
                <a href={`/til/${learning.id}/`} class="text-sm tracking-wide text-slate-500 hover:text-brand dark:text-slate-400">
                    {formatDate(learning.data.date)}
                </a>
                <div class="flex items-center gap-2 text-xl font-semibold sm:text-2xl">
                    {learning.data.title}
                    {learning.data.source && (
                        <a href={learning.data.source} class="text-brand hover:text-brand-hover" title="Source" target="_blank">
                            <LinkIcon class="size-4" />
                        </a>
                    )}
                </div>
                <div class="prose mt-2 max-w-none prose-slate dark:prose-invert prose-p:my-2 prose-a:text-brand prose-a:underline-offset-2 prose-a:hover:text-brand-hover">
                    <Content />
                </div>
            </div>
        ))}
    </div>
</Page>
