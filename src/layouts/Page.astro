---
import Base from '@/layouts/Base.astro';
import Prose from '@/components/Prose.astro';

interface Props {
    title: string;
    subtitle?: string;
    description?: string;
    prose?: boolean;
}

const { title, subtitle, description, prose = true } = Astro.props;
---

<Base title={title} description={description}>
    <header class="mb-10">
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
            {title}
        </h1>

        {subtitle && <div class="mt-2 text-lg text-slate-600 dark:text-slate-400">{subtitle}</div>}
    </header>

    {prose ? (
        <Prose>
            <slot />
        </Prose>
    ) : <slot />}
</Base>
