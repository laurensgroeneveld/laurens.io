---
import Base from '@/layouts/Base.astro';
import Prose from '@/components/Prose.astro';

interface Props {
    title: string;
    subtitle?: string;
    description?: string;
}

const { title, subtitle, description } = Astro.props;
---

<Base title={title} description={description}>
    <header>
        <h1 class="text-3xl tracking-tight">
            {title}
        </h1>

        {subtitle && <div class="mt-1 text-gray-700 text-lg">{subtitle}</div>}

        <div class="w-8 inline-block border-b-4 border-indigo-700 dark:border-indigo-500 pb-4 mb-4"></div>
    </header>

    <Prose>
        <slot />
    </Prose>
</Base>
